    "dc.contributor.other": [
      {
        "value": "FAIRmat is a consortium within Germany’s National Research Data Infrastructure (NFDI), funded by the German Research Foundation (DFG, project 460197019). It develops a FAIR data infrastructure for condensed-matter physics, the chemical physics of solids, and related areas of materials science. NOMAD is its core platform for managing, documenting, analyzing, and sharing research data.",
        "language": null,
        "authority": null,
