{
  "id": "8fed8231-a0f2-468e-a65e-2ea909cd7cff",
  "uuid": "8fed8231-a0f2-468e-a65e-2ea909cd7cff",
  "name": "NOMAD Central Platform",
  "handle": "eln/150.5",
  "metadata": {
    "AK.K04": [
      {
        "value": "NOMAD Central platform stores research data at the Max Planck Computing and Data Facility (MPCDF) in Germany.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.K20": [
      {
        "value": "NOMAD Central integrates with PubChem to populate substance records with chemical identifiers and properties. Through the NOMAD Remote Tools Hub (NORTH), users can run hosted analysis tools and Jupyter notebooks connected to NOMAD data.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.K31": [
      {
        "value": "NOMAD Central can receive measurement data and associated metadata from laboratory instruments through NOMAD CAMELS. CAMELS connects to and controls supported instruments, captures their output, and transfers the resulting data to NOMAD Central.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.K33": [
      {
        "value": "NOMAD’s Terms of Use state that personal information associated with user registration is managed in accordance with the GDPR and national data protection regulations. Its Privacy Policy describes the purposes and legal bases for processing personal information, retention practices, and users’ privacy rights.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.K41": [
      {
        "value": "Users can create their own data schemas, visualizations, and notebooks. There is a plugin mechanism for creating schemas and parsers to support additional data types.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.K44": [
      {
        "value": "NOMAD Central supports sign-in with a NOMAD account using a username or email and password, as well as federated sign-in through Helmholtz AAI using participating institutional or external identity providers. Authentication is managed through Keycloak using OpenID Connect (OIDC), which builds on OAuth 2.0.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.api": [
      {
        "value": "NOMAD Central provides a REST API for uploading, searching, retrieving, and managing research data and metadata. Users can access the API through Python libraries and scripts or command-line tools such as curl. An OPTIMADE API provides standardized access to materials structure data.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.automatisierung": [
      {
        "value": "NOMAD Central automatically processes supported uploaded files to extract and structure data and metadata. Through integration with NOMAD CAMELS, measurement data and associated metadata can be transferred from laboratory instruments to NOMAD Central. Users can automate uploads, searches, downloads, and processing through the REST API, and perform analysis workflows using NORTH tools and notebooks.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.betriebssystem": [
      {
        "value": "NOMAD Central runs on Linux server infrastructure. Users access the service through a web browser on Windows, macOS, Linux, or another compatible operating system.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.daten.eingabe": [
      {
        "value": "Users can define their own forms to acquire consistent datasets. Many files of many types can be processed, references, and analysed.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.daten.zugriff": [
      {
        "value": "NOMAD Central is accessible through a web browser. Users can create and edit ELN records, upload and explore data, manage projects, and publish research data through the web interface. Programmatic access is available through the REST API.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.fach": [
      {
        "value": "Materials science, condensed-matter physics, and the chemical physics of solids, including experimental characterization, materials synthesis, and computational research.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.import.formate": [
      {
        "value": "NOMAD Central imports experimental and computational data through installed parsers. Supported inputs include JSON and YAML files, CSV and Excel spreadsheets with appropriate schema mappings, scientific instrument and simulation files, and ZIP or TAR.GZ archives. Compatible ELN exports, including .eln files, can also be imported. Additional files can be stored alongside the data; automatic extraction of structured information depends on the available parser and schema.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.import.methode": [
      {
        "value": "There is also an API and data can be uploaded via command line tools.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.kollaboration": [
      {
        "value": "NOMAD Central allows project owners to share unpublished projects with collaborators. Reviewers can view files and entries, while coauthors can view and modify them. Project owners manage collaborator permissions and control when projects are published, including whether an embargo applies.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.kontroll.vokabular": [
      {
        "value": "NOMAD is built on structured data based on well-defined schema called the NOMAD Metainfo (https://nomad-lab.eu/prod/v1/gui/analyze/metainfo). NOMAD Metainfo can be extended and enhanced with standardized vocabularies and ontologies.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.labormanagement.funktionen": [
      {
        "value": "NOMAD Central supports structured records for substances, samples, and instruments. Samples can be linked to their constituent materials, preparation processes, measurements, and analyses, allowing researchers to trace their experimental history.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.lizenzmodell": [
      {
        "value": "NOMAD’s core software is distributed under the Apache License 2.0.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.nutzungsart": [
      {
        "value": "NOMAD Central is a hosted service accessible through a web browser. Researchers can use its ELN and data management features without installing or operating the server software themselves.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.suchfunktion": [
      {
        "value": "NOMAD Central supports keyword searches and filtering by indexed metadata, including ELN record types, tags, materials, methods, and properties. Users can combine search conditions and customize search widgets. The REST API supports structured queries with logical operators and numerical ranges.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.support": [
      {
        "value": "FAIRmat offers regular online hands-on tutorials. Users can interact directly with the developers and other users on the NOMAD Discord channel.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.templates": [
      {
        "value": "NOMAD Central provides built-in ELN templates for substances, samples, instruments, processes, measurements, and experiments. Users can define and upload custom templates using YAML schemas. They can also reuse schemas from their own projects or projects shared or published by other users.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AK.workflows": [
      {
        "value": "NOMAD Central enables researchers to document experimental workflows by linking samples, instruments, processes, measurements, and analyses. Processes can contain ordered steps, and experiment records can combine multiple activities. Interactive workflow graphs display these steps and their connections to the associated data.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AT.aktiv": [
      {
        "value": "active",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AT.aktiv.info": [
      {
        "value": "NOMAD is actively developed and maintained by the NOMAD team within FAIRmat. NOMAD Central Platform receives regular software updates, with stable releases typically published every two to three months. The latest software release is v2.0.0, with a changelog dated 18 October 2026",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AT.anbieter.sicherungsstrategie": [
      {
        "value": "NOMAD Central Platform stores and manages research data at the Max Planck Computing and Data Facility (MPCDF) in Germany. Project owners control access to unpublished data through reviewer and coauthor permissions. Published projects can have an embargo that restricts access to files until the embargo ends. NOMAD Central provides regular backups and data retention for at least ten years.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AT.community": [
      {
        "value": "NOMAD Discord Server (https://discord.gg/Gyzx3ukUw8) is a community channel for asking questions, receiving support, discussing NOMAD, and sharing feedback with developers and other users.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AT.exit.strategy": [
      {
        "value": "Users can download their original data files and retrieve processed data and metadata in structured JSON format through NOMAD’s web interface and REST API. Project files can be downloaded as ZIP archives. Institutions operating a NOMAD Oasis can back up the stored files and database to support restoration or migration.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
    "AT.nutzer2": [
      {
        "value": "NOMAD is used by Helmholtz-Zentrum Berlin für Materialien und Energie (HZB), Leibniz-Institut für Kristallzüchtung (IKZ), the Technical University of Denmark (DTU), RWTH Aachen University, Friedrich-Alexander-Universität Erlangen-Nürnberg (FAU), Humboldt-Universität zu Berlin, and many more institutions and research groups.",
        "language": null,
        "authority": null,
        "confidence": -1,
        "place": 0
      }
    ],
